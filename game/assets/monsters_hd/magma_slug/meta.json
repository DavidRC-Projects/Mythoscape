  "force_retaliate": true,
  "attack_facing": "client face_toward_target forces +-1 while swinging -> e/w frames; s/n attack frames exist for completeness"
 },
 "states": {
  "idle": {
   "frames": 4,
   "loop": true,
   "runtime": "frame = int(((t * 1.5) % 1.0) * 4)"
  },
  "walk": {
   "frames": 8,
   "loop": true,
   "runtime": "frame = int(((t * 1.15) % 1.0) * 8)   # same cadence as the HD player walk"
  },
  "attack": {
   "frames": 6,
   "loop": false,
   "frame_starts": [
    0.0,
    0.14,
    0.3,
    0.42,
    0.6,
    0.8
   ],
   "impact_frame": 3,
   "impact_progress": 0.48,
   "phases": {
    "windup": [
     0,
     1
    ],
    "strike": [
     2
    ],
    "impact": [
     3
    ],
    "follow_through": [
     4
    ],
    "recovery": [
     5
    ]
   },
   "runtime": "progress = client._attack_progress(mid) (0..1 over ATTACK_ANIM_SECS=1.05); frame = max(i for i, s in enumerate(frame_starts) if progress >= s)  -> f03 spans 0.42-0.60 so the hitsplat released at strike_t=0.48 lands on the impact frame"
  },
  "hit": {
   "frames": 3,
   "loop": false,
   "duration_s": 0.36,
   "runtime": "start when the queued hitsplat for a player_hits_monster hit (damage>0) on this knight is released (event time + 0.48*ATTACK_ANIM_SECS melee / 0.58*RANGED_ANIM_SECS ranged); frame = min(2, int(elapsed/0.12)); attack frames win if the knight is mid-swing; keep the red hurt tint on top"
  },
  "death": {
   "frames": 6,
   "loop": false,
   "duration_s": 0.9,
   "hold_fade_s": 0.6,
   "runtime": "on DEATH (entity_kind monster) snapshot type/x/y/facing into a client corpse list (the server drops the monster from state); frame = min(5, int(elapsed/0.15)); after 0.9 s hold f05 and fade alpha to 0 over 0.6 s"
  }
 },
 "files": "sprite_{1x,2x,4x}/{idle,walk,attack,hit,death}/{s,e,n,w}/fNN.png",
