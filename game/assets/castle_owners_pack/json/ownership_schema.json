  "persistence": {
    "suggested_table_or_blob": "castle_ownership",
    "fields": [
      {
        "name": "castle_id",
        "type": "string",
        "pk": true
      },
      {
        "name": "owner_account_id",
        "type": "string|null",
        "note": "null = vacant / For Sale"
      },
      {
        "name": "owner_display_name",
        "type": "string|null"
      },
      {
        "name": "purchased_at",
        "type": "unix_ts|null"
      },
      {
        "name": "last_tax_paid_at",
        "type": "unix_ts|null"
      },
      {
        "name": "tax_weeks_owed",
        "type": "int",
        "default": 0
      },
      {
        "name": "flags",
        "type": "object",
        "note": "future: vault_locked_for_tax etc."
      }
    ],
    "one_owner_per_castle": true,
    "one_castle_per_player": false,
    "note": "Allow multi-castle ownership unless David decides otherwise in Step 1."
  },
  "buy_flow": [
    "Player talks to seller NPC (USE_CASTLE_OWNERS on)",
    "Choose Buy \u2192 confirm",
    "Server checks: castle vacant; bank_coins >= deed_price; MAX_BANK_COINS allows balance",
    "Debit bank; set owner; grant deed_<castle_id> item (or bind deed to account if inventory full \u2014 prefer account-bound flag + optional item)",
    "Plaque swaps vacant_text \u2192 owner_display_name",
    "Chat: 'You are now the lord of <Castle>.'"
  ],
  "weekly_tax_flow": [
    "On weekly tick (reuse housing tax timer if one exists \u2014 confirm in Step 1)",
    "If owner bank >= weekly_tax: debit; update last_tax_paid_at",
    "Else: increment tax_weeks_owed; optional lock vault stub; do NOT auto-evict in Phase C"
  ],
  "out_of_scope_phase_c": [
    "Knight hire/fire/place combat AI (Phase D, USE_CASTLE_GUARDS) \u2014 dialogue stubs only",
    "Vault storage / robbery (Phase E, USE_CASTLE_VAULTS) \u2014 dialogue stubs only",
    "Interior rebuilds (Phases A/B)",
    "Walk-cycle changes"
  ]
}