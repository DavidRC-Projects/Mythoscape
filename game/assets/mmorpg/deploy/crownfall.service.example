# Example systemd unit. Copy to /etc/systemd/system/crownfall.service
# Adjust User, WorkingDirectory, and venv path.
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crownfall

[Unit]
Description=Crownfall game server
After=network.target

[Service]
Type=simple
User=crownfall
Group=crownfall
WorkingDirectory=/opt/crownfall/game/assets/mmorpg/server
Environment=CROWNFALL_ENV=production
Environment=CROWNFALL_HOST=127.0.0.1
Environment=CROWNFALL_PORT=8765
Environment=CROWNFALL_ALLOW_REGISTER=1
Environment=CROWNFALL_DEV=0
# Optional: Environment=CROWNFALL_DB_PATH=/var/lib/crownfall/world.db
ExecStart=/opt/crownfall/game/assets/mmorpg/.venv/bin/python server.py
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
# Soft resource caps (tune for your VPS)
MemoryMax=1G

# Harden process
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
