+        fl(surf, G[0], pts[0], pts[1], 1)
+
+
+def faulds(surf, s, pelvis, hw, top, look, view, t):
+    """Two-row lame skirt below the belt (plate legs)."""
+    b, d, l = look["pal"]
+    S = st(look)
+    for j in range(2):
